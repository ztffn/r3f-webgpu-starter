# Distant Front — server environment. Copy to .env and fill in.
#
# .env is gitignored; this file is the checked-in template and must never contain a
# real value. Nothing here is read by the browser build: Vite only exposes VITE_*
# variables, and the two secrets below are deliberately not among them.

# ─── REQUIRED. The game server refuses to start without both. ───────────────────

# Signs session tokens. Anyone who knows it can forge a session for any account.
# 24 characters minimum, enforced at boot.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Salts password hashes. REQUIRED because @colyseus/auth otherwise falls back to a
# salt that is published in its own source, which would make every deployment that
# forgets this share one public salt.
#
# Note the limitation this does not fix: the salt is process-wide, not per-user, so
# two accounts with the same password store the same hash. Treat it as a pepper and
# keep it secret. See docs/plans/2026-08-04-web-platform-and-ui-design.md section 5.3.
AUTH_SALT=

# ─── Optional ───────────────────────────────────────────────────────────────────

# Where the account database lives. `:memory:` is honoured and is what the tests
# use — it also means every account disappears on restart, so do not deploy with it.
DF2_DB=./account.db

# Discord sign-in. Both must be set or the provider is not registered at all, which
# also keeps @colyseus/auth's OAuth dependency tree (grant, and its unpatched
# advisories) off every code path. /api/config tells the client which providers
# exist, so the sign-in page only offers one that works.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Set to 1 only when a real payment provider is wired. Off means the supporter page
# says "opening soon" instead of showing a checkout that cannot complete. The
# client has its own VITE_CHECKOUT because that one is baked at build time; the
# server's is the one that must never grant a paid tier by accident.
DF2_CHECKOUT=0

# Weather and admin dials for the match server — see docs/12 section 9.
#   DF2_WEATHER=<preset id> | random | rotate
#   DF2_ADMIN=1  lets every connected client dial the room's visuals, AND opens
#                POST /api/me/tier so an account can grant itself the supporter
#                tier without a payment. Development only, twice over: the fog an
#                admin can lift is the concealment the game is built on, and the
#                grant hands out every paid capability for free. Off, the tier
#                route reports 404 rather than 403 — see the design record §5.6.
DF2_WEATHER=day
DF2_ADMIN=0
