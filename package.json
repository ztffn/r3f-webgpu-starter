{
  "name": "df2-web-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser reconstruction of Delta Force 2 (NovaLogic, 1999) — Phase 1 chunked LOD terrain on Three.js WebGPU + TSL.",
  "keywords": [
    "delta-force-2",
    "voxel-space",
    "terrain",
    "webgpu",
    "tsl",
    "three-fiber"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test tests/fps/*.test.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.9.0",
    "vite": "^8.1.5"
  }
}
